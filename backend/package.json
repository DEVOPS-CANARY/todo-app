{
  "name": "todo-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Todo API (NestJS + TypeORM + PostgreSQL): the golden path's sample backend",
  "license": "MIT",
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest",
    "migration:run": "typeorm migration:run -d dist/data-source.js",
    "migration:generate": "typeorm migration:generate -d dist/data-source.js"
  },
  "dependencies": {
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "@nestjs/typeorm": "11.0.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "helmet": "8.3.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "0.3.31"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.8",
    "@types/jest": "29.5.14",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "jest": "29.7.0",
    "prettier": "3.9.10",
    "ts-jest": "29.4.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "rootDir": "src",
    "testMatch": ["**/*.spec.ts"]
  }
}
